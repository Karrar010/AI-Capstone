# Copy to .env and fill in real values. Never commit .env.
# Docker Compose reads this file via env_file (optional) and variable substitution.

GROQ_API_KEY=
TAVILY_API_KEY=

# Postgres (used by docker-compose for api + postgres services)
POSTGRES_USER=bwa
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=bwa

# API port on host
API_PORT=8000
